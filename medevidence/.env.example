# MedEvidence - environment configuration
# Copy to `.env` before running docker-compose up.

# -- LLM / embeddings -------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Optional overrides (defaults ship in core/config.py)
ANTHROPIC_MODEL=claude-sonnet-4-20250514
EMBEDDING_MODEL=text-embedding-3-large

# -- Infrastructure ---------------------------------------------------
DATABASE_URL=postgresql+psycopg2://medevidence:medevidence@postgres:5432/medevidence
POSTGRES_PASSWORD=medevidence
WEAVIATE_URL=http://weaviate:8080
REDIS_URL=redis://redis:6379/0

# -- Auth / JWT -------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# -- PubMed -----------------------------------------------------------
PUBMED_EMAIL=admin@medevidence.local
PUBMED_API_KEY=

# -- Runtime ----------------------------------------------------------
ENV=production
LOG_LEVEL=INFO
