    { "name": "Scores",       "short_name": "Scores", "url": "./#scores",    "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Notes",        "short_name": "Notes",  "url": "./#notes",     "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
